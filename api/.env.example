# Copy to .env and adjust for your machine. Never commit .env.

DB_URL=jdbc:postgresql://localhost:5432/coaching_center_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres

JWT_SECRET=replace-with-a-long-random-secret

WEB_ORIGIN=http://localhost:3000

MASTER_ADMIN_PHONE=01700000001
MASTER_ADMIN_EMAIL=master@example.com
MASTER_ADMIN_NAME=Master Admin
MASTER_ADMIN_PASSWORD=replace-with-a-strong-password

# Dev profile only. When true, the API log includes verification, password-reset, and activation codes.
# HTTP responses stay unchanged. Staging and prod do not log those codes.
# DEV_EXPOSE_EMAIL_CODES=true

# Staging and production SMTP (Brevo). The dev profile does not send mail. Never commit a real password.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-brevo-smtp-login
MAIL_PASSWORD=replace-with-brevo-smtp-key
MAIL_FROM_ADDRESS=no-reply@symamlaw.com
MAIL_FROM_NAME=SYMAM LAW
# Optional. Leave unset to send with no Reply-To. The API still starts.
# MAIL_REPLY_TO=
# BREVO_API_KEY is used only when MAIL_PASSWORD is unset.

# Local folder for course covers, lecture files, and book covers. Not served as a public directory.
FILE_STORAGE_DIR=var/files

# The live store never goes in a dev file.
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_BASE_URL=
SSLCZ_CALLBACK_BASE_URL=
