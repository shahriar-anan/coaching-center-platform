# Copy to .env.local for development, or set these in the build environment.
# Values marked "build time" are inlined into the browser bundle by `next build`,
# so a build is made per environment.

# Student site origin. Build time.
# Staging tonight: https://srv2089893.hstgr.cloud
# Launch: https://exam.example.com
NEXT_PUBLIC_SITE_URL=https://srv2089893.hstgr.cloud

# Admin panel origin. Build time. Equal to NEXT_PUBLIC_SITE_URL means one host
# (staff under /staff). Launch: https://admin.exam.example.com
NEXT_PUBLIC_STAFF_URL=https://srv2089893.hstgr.cloud

# API base for the browser. Build time. Leave EMPTY in staging and launch: the
# browser then calls /api/... on its own host and Nginx forwards it to the API.
# Set it only for local development: http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=

# Turns the disabled Google button into a working one (U10). Build time.
# Set to true once the server has Google sign-in configured.
NEXT_PUBLIC_GOOGLE_ENABLED=false

# Optional, read at request time by proxy.ts (not inlined). When set, they take
# precedence over the NEXT_PUBLIC_ values above, so one build can move between hosts.
# SITE_URL=https://exam.example.com
# STAFF_URL=https://admin.exam.example.com
